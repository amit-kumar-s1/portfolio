# Copy to .env and adjust. Never commit .env.
DEBUG=false

# Exact origins allowed to call this API (comma separated). No wildcards.
CORS_ORIGINS=http://localhost:3000

# Contact endpoint rate limit, per IP.
CONTACT_RATE_LIMIT=3
CONTACT_RATE_WINDOW_SECONDS=3600

# Optional: email delivery for contact messages.
# Leave blank to only append messages to backend/data/messages.jsonl.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
